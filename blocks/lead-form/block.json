{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lead-forms/lead-form",
	"title": "Lead Form",
	"category": "widgets",
	"icon": "feedback",
	"description": "Embed one of your Lead Forms.",
	"keywords": [ "form", "contact", "enquiry", "lead" ],
	"textdomain": "lead-forms",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"formId": {
			"type": "number",
			"default": 0
		}
	},
	"editorScript": "file:./index.js",
	"style": "lead-forms"
}
