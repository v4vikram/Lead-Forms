<?xml version="1.0"?>
<ruleset name="Lead Forms">
	<description>Coding standards for the Lead Forms plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Targets: matches the plugin headers. -->
	<config name="minimum_supported_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!--
		Class files follow PSR-4 (one class per file, StudlyCase filename) so the
		autoloader can find them, rather than WordPress's class-*.php convention.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lead-forms"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lead_forms"/>
				<element value="LeadForms"/>
				<element value="lf_"/>
			</property>
		</properties>
	</rule>

	<!-- Verify the plugin still runs on every PHP version it claims to support. -->
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
