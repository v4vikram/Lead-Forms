{
	"name": "codevani/lead-forms",
	"description": "Dynamic contact and enquiry forms for WordPress with a field builder, per-field validation, lead storage and multi-recipient e-mail notifications.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"contact-form",
		"form-builder",
		"leads"
	],
	"homepage": "https://github.com/v4vikram/Lead-Forms",
	"authors": [
		{
			"name": "Vikram",
			"homepage": "https://github.com/v4vikram",
			"role": "Developer"
		}
	],
	"support": {
		"issues": "https://github.com/v4vikram/Lead-Forms/issues",
		"source": "https://github.com/v4vikram/Lead-Forms"
	},
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"LeadForms\\": "src/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"lint:php": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
	},
	"scripts-descriptions": {
		"lint": "Check the codebase against the WordPress Coding Standards.",
		"lint:fix": "Auto-fix the coding standard violations that can be fixed.",
		"lint:php": "Run a PHP syntax check over every file."
	}
}
